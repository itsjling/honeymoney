{
  "id": "hsbc_one_pdf",
  "account_id": "hsbc_one_hkd",
  "account": "HSBC One HKD",
  "account_type": "bank",
  "institution": "HSBC HK",
  "country": "HK",
  "account_currency": "HKD",
  "owner": "Household",
  "payment_method": "Bank Account",
  "date_formats": ["%Y-%m-%d"],
  "pdf": {
    "parser": "pdfplumber",
    "word_rows": "sectioned",
    "columns": {
      "transaction_date": "Date",
      "description": "Description",
      "debit": "Withdrawal",
      "credit": "Deposit",
      "account_id": "Account ID",
      "account": "Account",
      "original_currency": "Currency"
    },
    "sectioned_word_rows": {
      "accounts": {
        "HKD Savings": {
          "account_id": "hsbc_one_hkd_savings",
          "account": "HSBC One HKD Savings",
          "currency": "HKD"
        },
        "HKD Current": {
          "account_id": "hsbc_one_hkd_current",
          "account": "HSBC One HKD Current",
          "currency": "HKD"
        },
        "Foreign Currency Savings": {
          "account_id": "hsbc_one_fcy_savings",
          "account": "HSBC One Foreign Currency Savings",
          "currency_from_row": true
        }
      },
      "section_end_markers": [],
      "header_markers": [
        "Date",
        "Transaction",
        "Details",
        "Deposit",
        "Withdrawal",
        "Balance"
      ],
      "columns": {
        "currency": [50, 81],
        "description": [95, 330],
        "deposit": [330, 414],
        "withdrawal": [414, 480]
      },
      "date_regex": "^(?:(?P<currency>[A-Z]{3})\\s+)?(?P<day>\\d{1,2})\\s+(?P<month>[A-Za-z]{3})\\b",
      "currency_regex": "^[A-Z]{3}$",
      "statement_year_regex": "\\b(?P<statement_day>\\d{1,2})\\s+(?P<statement_month>[A-Za-z]{3,9})\\s+(?P<year>20\\d{2})\\b",
      "statement_year_filename_regex": "eStatementFile_(?P<year>20\\d{2})(?P<statement_month>\\d{2})(?P<statement_day>\\d{2})",
      "skip_descriptions": ["B/F BALANCE", "C/F BALANCE"],
      "table_end_descriptions": ["C/F BALANCE"]
    },
    "balance_mappings": [
      {
        "section": "HKD Savings",
        "currency": "HKD",
        "opening_regex": "^(?:\\d{1,2}\\s+[A-Za-z]{3}\\s+)?(?:B/F BALANCE|BALANCE B/F)\\s+(?P<balance>[+-]?\\d[\\d,]*\\.\\d{2})(?:\\s+(?P<balance_sign>CR|DR))?$",
        "closing_regex": "^(?:(?:\\d{1,2}\\s+[A-Za-z]{3}\\s+)?(?:C/F BALANCE|BALANCE C/F)\\s+(?P<balance>[+-]?\\d[\\d,]*\\.\\d{2})|TOTAL BALANCE\\s+(?P<total_balance>[+-]?\\d[\\d,]*\\.\\d{2})\\s+HKD)(?:\\s+(?P<balance_sign>CR|DR))?$",
        "closing_requires_opening": true
      },
      {
        "section": "HKD Current",
        "currency": "HKD",
        "opening_regex": "^(?:\\d{1,2}\\s+[A-Za-z]{3}\\s+)?(?:B/F BALANCE|BALANCE B/F)\\s+(?P<balance>[+-]?\\d[\\d,]*\\.\\d{2})(?:\\s+(?P<balance_sign>CR|DR))?$",
        "closing_regex": "^(?:(?:\\d{1,2}\\s+[A-Za-z]{3}\\s+)?(?:C/F BALANCE|BALANCE C/F)\\s+(?P<balance>[+-]?\\d[\\d,]*\\.\\d{2})|TOTAL BALANCE\\s+(?P<total_balance>[+-]?\\d[\\d,]*\\.\\d{2})\\s+HKD)(?:\\s+(?P<balance_sign>CR|DR))?$",
        "closing_requires_opening": true
      },
      {
        "section": "Foreign Currency Savings",
        "currency_group": "currency",
        "opening_regex": "^(?=.*\\b(?P<currency>(?-i:[A-Z]{3}))\\b)(?:(?:[A-Z]{3}|\\d{1,2}\\s+[A-Za-z]{3})\\s+){1,2}(?:B/F BALANCE|BALANCE B/F)\\s+(?P<balance>[+-]?\\d[\\d,]*\\.\\d{2})(?:\\s+(?P<balance_sign>CR|DR))?$",
        "closing_regex": "^(?=.*\\b(?P<currency>(?-i:[A-Z]{3}))\\b)(?:(?:(?:[A-Z]{3}|\\d{1,2}\\s+[A-Za-z]{3})\\s+){1,2}(?:C/F BALANCE|BALANCE C/F)\\s+(?P<balance>[+-]?\\d[\\d,]*\\.\\d{2})|TOTAL BALANCE\\s+(?P<total_balance>[+-]?\\d[\\d,]*\\.\\d{2})\\s+[A-Z]{3})(?:\\s+(?P<balance_sign>CR|DR))?$",
        "closing_requires_opening": true
      }
    ]
  },
  "skip_descriptions": [
    "B/F BALANCE",
    "C/F BALANCE",
    "BALANCE B/F",
    "BALANCE C/F"
  ]
}
